# /etc/systemd/system/ymatter-bridge.service  (хост-мост: Raspberry Pi / сервер с HA)
[Unit]
Description=Yandex Station Matter -> MQTT bridge
After=network-online.target
Wants=network-online.target

[Service]
User=ymatter
Environment=YMATTER_CONFIG=/etc/ymatter/config.toml
EnvironmentFile=-/etc/ymatter/secrets.env     # YMATTER_MQTT_PASSWORD=...
ExecStart=/opt/ymatter/venv/bin/ymatter bridge
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
